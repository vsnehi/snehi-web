<div class="cursor-glow"></div>
<mat-sidenav-container class="sidenav-container" [class.minimized]="isMinimized()">
  <!-- Sidebar -->
  <mat-sidenav #sidenav class="premium-sidenav" [class.minimized]="isMinimized()" mode="side"
    [opened]="sidenavOpened()">
    <!-- Sidebar Header -->
    @if (!isMinimized()) {
    <div class="sidenav-header">
      <div class="logo-container">
        <div class="logo" style="background: url('assets/logo.png') no-repeat center center; background-size: contain;">
          
        </div>
      </div>
      <h2 class="brand-name">
        Snehi Limited
      </h2>
    </div>
    }

    <!-- Minimized Logo -->
    @if (isMinimized()) {
    <div class="sidenav-header-minimized">
      <div class="logo-minimized">
        S
      </div>
    </div>
    }

    <!-- Navigation -->
    <nav class="nav-menu">
      @for (item of navItems; track item.label) {
      <a [routerLink]="item.route" routerLinkActive="active" class="nav-item" [class.minimized]="isMinimized()">
        <mat-icon class="nav-icon">
          {{ item.icon }}
        </mat-icon>
        @if (!isMinimized()) {
        <span class="nav-label">
          {{ item.label }}
        </span>
        }
      </a>
      }
    </nav>

    @if (!isMinimized()) {
    <div class="divider"></div>
    <div class="sidebar-footer">
      <span class="premium-badge" routerLink="/login">
        <mat-icon>
          star
        </mat-icon>
        <span>{{ username() ? ('Welcome, ' + username()) : 'Login...?' }}</span>
      </span>
    </div>
    }
  </mat-sidenav>
  <!-- Main Content -->
  <mat-sidenav-content class="sidenav-content">
    <!-- Top Navbar -->
    <div class="top-navbar">
      <div class="navbar-left">
        <button mat-icon-button (click)="toggleMinimize()" class="minimize-btn" title="Minimize sidebar">
          <mat-icon>
            {{
            isMinimized()
            ? 'unfold_more'
            : 'unfold_less'
            }}
          </mat-icon>
        </button>
        <h1 class="page-title">
          Dashboard
        </h1>
      </div>
      <div class="spacer"></div>
      <div class="navbar-right">
        <button mat-icon-button class="profile-btn" routerLink="/login">
          <mat-icon>
            account_circle
          </mat-icon>
        </button>
      </div>
    </div>
    <!-- Content -->
    <div class="main-content">
      <router-outlet></router-outlet>
    </div>
  </mat-sidenav-content>
</mat-sidenav-container>























.cursor-glow {
    position: fixed;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    pointer-events: none;

    background:
        radial-gradient(circle,
            rgba(168, 85, 247, .22) 0%,
            rgba(59, 130, 246, .12) 35%,
            transparent 70%);

    filter: blur(60px);

    transform:
        translate(-50%, -50%);

    z-index: 9999;

    mix-blend-mode: screen;

    left: 0;
    top: 0;

    transition:
        left .08s linear,
        top .08s linear;
}

.mat-drawer-content {
    margin-left: 0 !important;
}

.sidenav-container {
    height: 100vh;
    display: flex;
    margin-left: 0 !important;
    transition: all .3s ease;
}

.sidenav-container.minimized .premium-sidenav {
    width: 80px !important;
}

.premium-sidenav {
    width: 260px;

    background:
        linear-gradient(180deg,
            #0f172a 0%,
            #111827 25%,
            #1e1b4b 55%,
            #312e81 100%);

    box-shadow:
        0 0 40px rgba(99, 102, 241, .35);

    padding: 0;
    overflow-y: auto;
    position: relative;
    backdrop-filter: blur(20px);
    transition: width .3s ease;
}

.premium-sidenav::before {
    content: '';
    position: absolute;
    inset: 0;

    background:
        url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');

    pointer-events: none;
}

.sidenav-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;

    background:
        linear-gradient(135deg,
            #020617 0%,
            #0f172a 35%,
            #111827 100%) !important;
}

.sidenav-content::before {
    content: '';
    position: absolute;
    inset: -50%;

    background:

        radial-gradient(circle at 20% 20%,
            rgba(168, 85, 247, .18),
            transparent 20%),

        radial-gradient(circle at 80% 30%,
            rgba(59, 130, 246, .16),
            transparent 22%),

        radial-gradient(circle at 50% 80%,
            rgba(236, 72, 153, .14),
            transparent 18%),

        repeating-radial-gradient(circle at center,
            rgba(255, 255, 255, .025) 0px,
            rgba(255, 255, 255, .025) 2px,
            transparent 3px,
            transparent 12px);

    filter:
        blur(40px) contrast(160%);

    animation:
        aiMorph 18s ease-in-out infinite alternate;

    opacity: .9;

    pointer-events: none;
    z-index: 0;
}

.top-navbar,
.main-content {
    position: relative;
    z-index: 1;
    overflow: hidden;
}

.top-navbar {
    height: 48px;
    display: flex;
    align-items: center;
    padding: 0 30px;

    background:
        rgba(15, 23, 42, .7);

    backdrop-filter: blur(20px);

    border-bottom:
        1px solid rgba(255, 255, 255, .06);

    box-shadow:
        0 4px 20px rgba(0, 0, 0, .25);
}

.navbar-left,
.navbar-right {
    display: flex;
    align-items: center;
    gap: 15px;
}

.spacer {
    flex: 1;
}

.page-title {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin: 0;
}

.minimize-btn,
.profile-btn {
    color: #a855f7;
    transition: .3s ease;
}

.minimize-btn:hover,
.profile-btn:hover {
    transform: scale(1.1);
    color: #fff;
}

.main-content {
    flex: 1;
    padding: 30px;
    overflow-y: auto;
}

.sidenav-header {
    padding: 25px 15px;
    text-align: center;
    border-bottom:
        1px solid rgba(255, 255, 255, .08);

    position: relative;
    z-index: 1;
}

.logo-container {
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
}

.logo {
    width: 50px;
    height: 50px;
    border-radius: 50%;

    background:
        linear-gradient(135deg,
            rgba(255, 255, 255, .2),
            rgba(255, 255, 255, .08));

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 24px;
    font-weight: 700;
    color: #fff;

    box-shadow:
        0 8px 20px rgba(0, 0, 0, .2);

    animation:
        float 3s ease-in-out infinite;
}

.brand-name {
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    letter-spacing: 1px;
}

.nav-menu {
    padding: 15px 0;
    position: relative;
    z-index: 1;
}

.nav-item {
    display: flex;
    align-items: center;
    padding: 12px 20px;

    color:
        rgba(255, 255, 255, .9);

    text-decoration: none;

    transition:
        all .3s ease;

    border-left:
        4px solid transparent;

    cursor: pointer;

    position: relative;
    overflow: hidden;
}

.nav-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;

    background:
        rgba(255, 255, 255, .08);

    transition: left .3s ease;
}

.nav-item:hover {
    border-left-color: #fff;

    background:
        rgba(255, 255, 255, .08);

    padding-left: 25px;
}

.nav-item:hover::before {
    left: 0;
}

.nav-item.active {
    background:
        linear-gradient(90deg,
            rgba(99, 102, 241, .32),
            rgba(168, 85, 247, .18));

    border-left:
        4px solid #a855f7;

    box-shadow:
        0 0 20px rgba(99, 102, 241, .2);

    backdrop-filter: blur(10px);
}

.nav-icon {
    width: 24px;
    margin-right: 15px;
    font-size: 20px;
    flex-shrink: 0;
}

.nav-label {
    font-size: 13px;
    white-space: nowrap;
}

.divider {
    height: 1px;

    background:
        linear-gradient(90deg,
            transparent,
            rgba(255, 255, 255, .2),
            transparent);

    margin: 15px 0;
}

.sidebar-footer {
    padding: 15px;
}

.premium-badge {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 10px 15px;

    background:
        rgba(255, 255, 255, .12);

    border:
        1px solid rgba(255, 255, 255, .2);

    border-radius: 15px;

    color: #fff;
    font-size: 11px;
    font-weight: 600;

    backdrop-filter: blur(10px);

    transition: .3s ease;
}

.premium-badge:hover {
    transform: translateY(-2px);

    background:
        rgba(255, 255, 255, .18);

    box-shadow:
        0 8px 20px rgba(0, 0, 0, .2);
}

@keyframes float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }

}

@keyframes aiMorph {

    0% {
        transform:
            translate(-5%, -5%) rotate(0deg) scale(1);
    }

    25% {
        transform:
            translate(3%, -2%) rotate(20deg) scale(1.1);
    }

    50% {
        transform:
            translate(-2%, 4%) rotate(-15deg) scale(1.05);
    }

    75% {
        transform:
            translate(4%, 2%) rotate(10deg) scale(.95);
    }

    100% {
        transform:
            translate(-3%, -4%) rotate(-10deg) scale(1.08);
    }

}

.premium-sidenav::-webkit-scrollbar,
.sidenav-content::-webkit-scrollbar {
    width: 6px;
}

.premium-sidenav::-webkit-scrollbar-thumb {
    background:
        rgba(255, 255, 255, .3);

    border-radius: 3px;
}

.sidenav-content::-webkit-scrollbar-thumb {
    background:
        rgba(168, 85, 247, .35);

    border-radius: 3px;
}

@media(max-width:768px) {

    .premium-sidenav {
        width: 80px !important;
    }

    .nav-label,
    .brand-name,
    .sidebar-footer,
    .divider {
        display: none;
    }

    .nav-item {
        justify-content: center;
        padding: 15px 0;
    }

    .nav-icon {
        margin-right: 0;
    }

    .main-content {
        padding: 15px;
    }

    .top-navbar {
        padding: 0 15px;
    }

    .top-navbar {
        backdrop-filter: blur(30px);
    }

}